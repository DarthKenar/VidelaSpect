<section class="p-10">
    <h1 class="text-center font-semibold text-4xl uppercase">{{personal.name}}</h1>
    {{>messages}}
    <form action="/personal/password/send" method="post" class="flex flex-col gap-5 max-w-xs m-auto">
        <input class="input input-bordered w-full max-w-xs" placeholder="Contraseña" type="password" name="password" id="password">
        <input class="btn btn-outline max-w-xs" type="submit" value="ENVIAR">
    </form>
</section>