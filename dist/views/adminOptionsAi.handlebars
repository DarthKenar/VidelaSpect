{{>backToGeneralOptions}}
{{>imageProfile}}
{{>messages}}

<div class="flex flex-col items-center justify-center m-auto gap-2 ">
    <svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-cpu pb-10"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line>{{#unless aiOptions.status}}<line x1="1" y1="23" x2="23" y2="1" stroke-width="1.5" stroke-linecap="round"></line>{{/unless}}</svg>
    <form action="/admin/options/ai/send" method="post">
        <div class="form-control w-72 gap-10">
            <label class="cursor-pointer label">
                <span class="label-text">ESTADO IA</span> 
                <input id="status" name="status" type="checkbox" class="toggle toggle-primary" {{#if aiOptions.status}}checked{{/if}}/>
            </label>
            <input type="range" min="0" max="100" value="{{aiOptions.accuracy}}" class="range range-md" />
            <div class="py-5 flex justify-end">
                <button class="btn btn-outline btn-sm" type="submit">Actualizar</button>
            </div>
        </div>

    </form>
</div>