<dialog id="my_modal_3" class="modal">
      <div class="modal-box">
         <form method="dialog">
         <a href="/personal/dni" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</a>
         </form>
         <h3 class="font-bold text-lg">{{personal.name}}</h3>
        <textarea class="py-4 w-full resize-none h-32"  readonly >{{#with messages.[0]}}{{message}}{{/with}}</textarea>
      </div>
</dialog>
<script>
document.addEventListener("DOMContentLoaded", function() {
var dialog = document.getElementById("my_modal_3");
dialog.showModal();
});
</script>