<menu class="flex justify-evenly py-10 ">
  {{>backToPanel}}
  <a href=""></a>
  <div class="join">
    
    {{!-- Fechas --}}
    <div id="dateGroup" class="join-item hidden flex flex-row gap-5 justify-center items-center">
      <label for="fromDate">Desde:</label>
      <input type="date" class="input input-bordered" id="fromDate" name="fromDate">
      <label for="fromDate">Hasta:</label>
      <input type="date" class="input input-bordered" id="toDate" name="toDate">
    </div>

    {{!-- Horarios --}}
    <div id="timeGroup" class="join-item hidden flex flex-row gap-5 justify-center items-center">
      <label for="fromTime">Desde:</label>
      <input type="time" class="input input-bordered" id="fromTime" name="fromTime">
      <label for="fromTime">Hasta:</label>
      <input type="time" class="input input-bordered" id="toTime" name="toTime">
    </div>

    {{!-- Boton para filtrar fechas y horarios --}}
    <input hx-get="/admin/panel/registros/search" hx-target="#search_results" hx-include="[name='select'], [name='fromTime'], [name='toTime'], [name='fromDate'], [name='toDate']" id="getDataTimeBtn" type="button" class="btn join-item btn-primary btn-outline hidden ml-5" value="FILTRAR">
    {{!-- Nombres --}}
    <input hx-get="/admin/panel/registros/search"  hx-trigger="keyup changed delay:300ms" hx-target="#search_results" hx-include="[name='select'], [name='name']" id="name" name="name" value="{{input}}" class="input input-bordered join-item border-primary input-primary " placeholder="Buscar"/>
    <select hx-get="/admin/panel/registros/search" hx-trigger="change" hx-target="#search_results" hx-include="[name='select'], [name='input']" id="select" name="select" class="select select-bordered join-item select-primary" onchange="changeInput()">
      <option value="personal_name">Nombre</option>
      <option value="date">Fecha</option>
      <option value="time">Hora</option>
    </select>
  </div>
  <a href=""></a>
  <aside class="absolute right-0 top-0 m-10">
    <div class="form-control">
      <label class="cursor-pointer label">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        <span class="label-text px-4">Descargar</span>
        <input type="checkbox" checked="checked" class="checkbox checkbox-primary" disabled checked/>
      </label>
      <label class="cursor-pointer label">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-send"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        <span class="label-text px-4">Enviar a email</span>
        <input name='email' id="email" type="checkbox" checked="checked" class="checkbox checkbox-primary" />
      </label>
      <label class="label flex justify-center">
        <a hx-get="/admin/panel/registros/excel" hx-trigger="click" hx-target="#search_results" hx-include="[name='select'], [name='input'], [name='email']" class="cursor-pointer btn btn-outline btn-primary btn-sm" title="Descargar/Enviar Excel de Registros" id="downloadOrSendBtn" hx-on::before-request="disabledButton()" hx-on::after-request="enableButton('registros')">
          SOLICITAR
        </a>
      </label>
    </div>
  </aside>
</menu>
<div id="search_results" class="overflow-x-auto">
  {{>messages}}
  <table class="table table-xs">
    <thead>
      <tr>
        <th></th> 
        <th>Nombre</th> 
        <th>Fecha y Hora</th> 
        <th>Foto</th> 
      </tr>
    </thead>
    <tbody>
        {{#each registros}}
            <tr>
                <td>{{this.id}}</td>
                <td>{{this.personal_name}}</td> 
                <td>{{this.dateTime}}</td> 
                <td>
                  <a onclick="getImage({{this.id}})" class="btn btn-sm btn-info btn-outline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-camera"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                    VER
                  </a>
                </td>
            </tr>
        {{/each}}
    </tbody> 
    <tfoot>
      <tr>
        <th></th> 
        <th>Nombre</th> 
        <th>Fecha y Hora</th> 
        <th>Tiempo</th>
      </tr>
    </tfoot>
  </table>
</div>
<dialog id="my_modal_3" class="modal">
      <div class="modal-box">
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
        </form>
        <img id="registroFoto" src="" alt="">
      </div>
</dialog>
<script src="/js/adminPanelRegistros.js"></script>
<script defer src="/js/adminPanelPersonalRegistros.js"></script>