{{>backToGeneralOptions}}
{{>imageProfile}}
{{>messages}}

<div class="flex flex-col items-center justify-center m-auto gap-2 ">
    <svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-text mb-10 block"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
    <form id="autoPanel" action="/admin/options/records/del/send" method="post" style="border-radius: var(--rounded-btn, 0.5rem/* 8px */);" class="p-10 border-2 border-primary flex flex-col justify-center items-center gap-10 hidden">
        <h2 class="text-xl font-semibold">CONTROLES <span class="text-primary font-bold">AUTOMÁTICOS</span> DE ELIMINACIÓN DE REGISTROS</h2>
        <button class="btn btn-outline btn-error">Eliminar Registro</button>
    </form>
    <form id="manualPanel" action="/admin/options/records/del/send" method="post" style="border-radius: var(--rounded-btn, 0.5rem/* 8px */);" class="p-10 border-2 border-primary flex flex-col justify-center items-center gap-10">
        <h2 class="text-xl font-semibold">CONTROLES <span class="text-primary font-bold">MANUALES</span> DE ELIMINACIÓN DE REGISTROS</h2>
        <button class="btn btn-outline btn-error">Eliminar Registro</button>
    </form>

    <div class="btm-nav btm-nav-lg">
        <button id="autoPanelBtn" onclick="showAutoPanel()">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-refresh-cw"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
            <span class="btm-nav-label">Automático</span>
        </button>
        <button id="manualPanelBtn" class="active text-primary" onclick="showManualPanel()" >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span class="btm-nav-label">Manual</span>
        </button>
    </div>
</div>
<script src="/js/adminPanelRegisterDelete.js"></script>