
<menu class="flex justify-evenly py-10">
  {{>backToPanel}}
  <a href=""></a>
  <div class="join">
    <div>
      <input hx-get="/admin/panel/personal/search" hx-trigger="keyup changed delay:300ms" hx-target="#search_results" hx-include="[name='select'], [name='input']" id="input" name="input" value="{{input}}" class="input input-bordered join-item" placeholder="Buscar"/>
    </div>
    <select hx-get="/admin/panel/personal/search" hx-trigger="change" hx-target="#search_results" hx-include="[name='select'], [name='input']" id="select" name="select" class="select select-bordered join-item">
      <option value="name" {{#if_eq select "name"}} selected {{/if_eq}}>Nombre</option>
      <option value="dni" {{#if_eq select "dni"}} selected {{/if_eq}}>DNI</option>
    </select>
  </div>
  <a href="/admin/panel/personal/create" class="btn btn-outline btn-success" title="Agregar un nuevo miembro del personal">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-circle"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
    AGREGAR
  </a>
  <aside class="absolute right-0 top-0 m-10">
    <div class="form-control">
      <label class="cursor-pointer label">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        <span class="label-text px-4">Descargar</span>
        <input type="checkbox" checked="checked" class="checkbox checkbox-primary" disabled checked/>
      </label>
      <label class="cursor-pointer label">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-send"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        <span class="label-text px-4">Enviar a email</span>
        <input name='email' id="email" type="checkbox" checked="checked" class="checkbox checkbox-primary" />
      </label>
      <label class="cursor-pointer label flex justify-center">
        <a hx-get="/admin/panel/personal/excel" hx-trigger="click" hx-target="#search_results" hx-include="[name='select'], [name='input'], [name='email']" class="btn btn-outline btn-primary btn-sm" title="Descargar/Enviar Excel de Personal">
          SOLICITAR
        </a>
      </label>
    </div>
  </aside>

</menu>
<div id="search_results" class="overflow-x-auto">
  {{>messages}}
  <table class="table table-xs">
    <thead>
      <tr>
        <th></th> 
        <th>Nombre</th> 
        <th>DNI</th> 
        <th>Cargo</th> 
        <th title="Registros totales por día.">Reg. x día</th>
        <th>Administrador</th>
        <th>Acción</th>
      </tr>
    </thead>
    <tbody>
        {{#each personal}}
            <tr>
                <th>{{this.id}}</th> 
                <td>{{this.name}}</td> 
                <td>{{this.dni}}</td> 
                <td>{{this.position}}</td>
                <td>{{this.dailyEntries}}</td> 
                <td>
                  {{#if this.admin}}
                    Si
                  {{else}}
                    No
                  {{/if}}
                </td>
                <td class="flex flex-row">
                  <a href="/admin/panel/personal/update/{{this.id}}" class="btn btn-outline btn-warning btn-sm mr-1" {{#if this.admin}}disabled="disabled"{{/if}} title="Editar los datos de {{this.name}}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                  EDITAR
                  </a>
                  <form action="/admin/panel/personal/delete/{{this.id}}" method="POST">
                    <button type="submit" class="btn btn-outline btn-error btn-sm" {{#if this.admin}}disabled="disabled"{{/if}} onclick="return confirm('¿Estás seguro de que quieres eliminar a {{this.name}} del personal?')" title="Eliminar a {{this.name}}">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash-2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                      ELIMINAR
                    </button>
                  </form>
                </td>
            </tr>
        {{/each}}
    </tbody> 
    <tfoot>
      <tr>
        <th></th> 
        <th>Nombre</th> 
        <th>DNI</th> 
        <th>Cargo</th> 
        <th title="Registros totales por día.">Reg. x día</th>
        <th>Administrador</th>
        <th>Acción</th>
      </tr>
    </tfoot>
  </table>
</div>