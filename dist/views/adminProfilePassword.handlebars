{{>backToProfile}}
{{>imageProfile}}
{{>messages}}
<div class="flex flex-col items-center justify-center m-auto gap-2 ">
    <form action="/admin/profile/password/send" method="post">
        <label class="form-control w-full max-w-md">
            <div class="label">
                <span class="label-text">Contraseña actual</span>
            </div>
            <div class="password-container">
                <input name="password_old" id="password_old" value="{{passwordOld}}" class="input input-bordered w-[28rem] max-w-md password-input" type="password">
                <button type="button" class="btn btn-sm btn-circle eye-icon-button" onclick="passShowHide('password_old', 'password_old_svg')">
                    <svg id="password_old_svg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
            </div>
        </label>
        <div class="divider"></div>
        <label class="form-control w-full max-w-md">
            <div class="label">
                <span class="label-text">Nueva contraseña</span>
            </div>
            <div class="password-container">
                <input name="password" id="password" value="{{password}}" class="input input-bordered w-[28rem] max-w-md password-input" type="password">
                <button type="button" class="btn btn-sm btn-circle eye-icon-button" onclick="passShowHide('password','password_svg')">
                    <svg id="password_svg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
            </div>
        </label>
        <label class="form-control w-full max-w-md">
            <div class="label">
                <span class="label-text">Repetir nueva contraseña</span>
            </div>
            <div class="password-container">
                <input name="password2" id="password2" value="{{password2}}" class="input input-bordered w-[28rem] max-w-md password-input" type="password">
                <button type="button" class="btn btn-sm btn-circle eye-icon-button" onclick="passShowHide('password2','password2_svg')">
                    <svg id="password2_svg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
            </div>
        </label>
        <div class="py-5 flex justify-end">
            <button class="btn btn-outline btn-sm" type="submit">Actualizar</button>
        </div>
    </form>
</div>
<script defer src="/js/passShowHide.js"></script>