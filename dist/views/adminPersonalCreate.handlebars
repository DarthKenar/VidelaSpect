{{>messages}}
<section class="flex justify-center">
  <div class="bg-base-300 flex flex-col items-center justify-center rounded-xl w-[30rem]">
    <h1 class="py-10 font-semibold">CREAR PERSONAL</h1>
    <form class="w-full max-w-xs" action="/admin/panel/personal/create" method="POST">
      <label class="form-control w-full max-w-xs my-1">
        <input id="nombre" name="nombre" type="text" value="{{newUser.name}}" placeholder="Nombre" class="input input-bordered w-full max-w-xs" />
      </label>
      <label class="form-control w-full max-w-xs my-1">
        <input id="dni" name="dni" type="text" placeholder="Dni" value="{{newUser.dni}}" class="input input-bordered w-full max-w-xs" />
      </label>
      <label class="form-control w-full max-w-xs my-1">
        <input id="position" name="position" type="text" placeholder="Cargo" value="{{newUser.position}}" class="input input-bordered w-full max-w-xs" />
      </label>
      <label id="dailyEntriesLabel" class="form-control w-full max-w-xs my-1">
        <input id="dailyEntries" name="dailyEntries" type="number" value="{{newUser.dailyEntries}}" placeholder="Cantidad de entradas diarias" class="input input-bordered w-full max-w-xs" />
      </label>
      <div class="collapse bg-base-200" style="border-radius: var(--rounded-btn, 0.5rem/* 8px */);">
        <input id="collapse-checkbox" type="checkbox" /> 
        <div class="collapse-title text-xl font-medium" >
          <div class="form-control">
            <label class="label cursor-pointer max-w-xs">
              <span class="label-text">Administrador</span> 
              <input id="admin" name="admin" type="checkbox" class="checkbox" />
            </label>
          </div>
        </div>
        <div class="collapse-content"> 
          <label class="input input-bordered flex items-center gap-2 input-xs">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4 opacity-70"><path fill-rule="evenodd" d="M14 6a4 4 0 0 1-4.899 3.899l-1.955 1.955a.5.5 0 0 1-.353.146H5v1.5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-2.293a.5.5 0 0 1 .146-.353l3.955-3.955A4 4 0 1 1 14 6Zm-4-2a.75.75 0 0 0 0 1.5.5.5 0 0 1 .5.5.75.75 0 0 0 1.5 0 2 2 0 0 0-2-2Z" clip-rule="evenodd" /></svg>
            <input id="password" name="password" type="password" class="grow" placeholder="Contraseña" />
          </label>
          <label class="input input-bordered flex items-center gap-2 input-xs">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4 opacity-70"><path fill-rule="evenodd" d="M14 6a4 4 0 0 1-4.899 3.899l-1.955 1.955a.5.5 0 0 1-.353.146H5v1.5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-2.293a.5.5 0 0 1 .146-.353l3.955-3.955A4 4 0 1 1 14 6Zm-4-2a.75.75 0 0 0 0 1.5.5.5 0 0 1 .5.5.75.75 0 0 0 1.5 0 2 2 0 0 0-2-2Z" clip-rule="evenodd" /></svg>
            <input id="password2" name="password2" type="password" class="grow" placeholder="Repetir contraseña" />
          </label>
          <label class="input input-bordered flex items-center gap-2 input-xs">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4 opacity-70"><path d="M2.5 3A1.5 1.5 0 0 0 1 4.5v.793c.026.009.051.02.076.032L7.674 8.51c.206.1.446.1.652 0l6.598-3.185A.755.755 0 0 1 15 5.293V4.5A1.5 1.5 0 0 0 13.5 3h-11Z" /><path d="M15 6.954 8.978 9.86a2.25 2.25 0 0 1-1.956 0L1 6.954V11.5A1.5 1.5 0 0 0 2.5 13h11a1.5 1.5 0 0 0 1.5-1.5V6.954Z" /></svg>
            <input id="email" name="email" type="text" class="grow" placeholder="Email" value="{{email}}" />
            <span class="badge badge-info text-xs">Opcional</span>
          </label>
          <label class="input input-bordered flex items-center gap-2 input-xs">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4 opacity-70"><path d="M2.5 3A1.5 1.5 0 0 0 1 4.5v.793c.026.009.051.02.076.032L7.674 8.51c.206.1.446.1.652 0l6.598-3.185A.755.755 0 0 1 15 5.293V4.5A1.5 1.5 0 0 0 13.5 3h-11Z" /><path d="M15 6.954 8.978 9.86a2.25 2.25 0 0 1-1.956 0L1 6.954V11.5A1.5 1.5 0 0 0 2.5 13h11a1.5 1.5 0 0 0 1.5-1.5V6.954Z" /></svg>
            <input id="phone" name="phone" type="phone" class="grow" placeholder="N° de teléfono" value="{{phone}}" />
            <span class="badge badge-info text-xs ">Opcional</span>
          </label>
        </div>
      </div>
      <div class="label cursor-pointer max-w-xs place-content-end py-10">
        <input class="btn btn-outline btn-success " type="submit" value="CREAR">
      </div>
    </form>
  </div>
</section>
<script src="/js/adminPersonalCreateUpdate.js"></script>


